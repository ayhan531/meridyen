# Yerel geliştirme (üretimde Render ayarlar)
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meridyen
JWT_SECRET=uzun-rastgele-bir-deger
# Harici (Render dışı) bağlantıda TLS gerekirse true
DATABASE_SSL=false
COOKIE_SECURE=false
SEED_DEMO=true
# screen: iki adımlı doğrulama kodu ekranda gösterilir · log: yalnızca sunucu günlüğüne yazılır
SMS_MODE=screen
